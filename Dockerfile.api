# ── Etapa 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Instalar todas las dependencias del workspace
COPY package.json package-lock.json ./
COPY packages/types/package.json ./packages/types/package.json
COPY apps/api/package.json       ./apps/api/package.json
RUN npm ci && npm install -g @nestjs/cli

ARG CACHEBUST=1

# Copiar código fuente
COPY packages/types ./packages/types
COPY apps/api       ./apps/api

# Generar cliente Prisma y compilar
RUN cd apps/api && npx prisma generate --schema=src/prisma/schema.prisma
RUN cd apps/api && nest build && ls -la dist/

# ── Etapa 2: imagen de producción ────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules          ./node_modules
COPY --from=builder /app/packages/types        ./packages/types
COPY --from=builder /app/apps/api/dist         ./dist
COPY --from=builder /app/apps/api/src/prisma   ./src/prisma
COPY --from=builder /app/apps/api/package.json ./package.json

EXPOSE 3001

CMD ["sh", "-c", "npx prisma migrate deploy --schema=src/prisma/schema.prisma && node dist/src/main"]
