# Base de datos
DATABASE_URL="postgresql://usuario:password@host:5432/dispatch_track?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generar con: openssl rand -hex 32
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# QR — generar con: openssl rand -hex 32
QR_HMAC_SECRET=""

# CORS — URL del frontend en producción
FRONTEND_URL="https://tu-dominio.com"

# Puerto de la API
PORT=3001
