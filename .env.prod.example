# ── Copiar a .env.prod y completar todos los valores ──────────────────────────
# Usar: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# IMPORTANTE: La API rechaza el arranque en producción si:
#   - JWT_SECRET o JWT_REFRESH_SECRET están vacíos
#   - JWT_SECRET o JWT_REFRESH_SECRET tienen menos de 32 caracteres
#   - Contienen palabras débiles (secret, password, 123, etc.)
#
# Generar secretos seguros:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   openssl rand -hex 32

NODE_ENV=production

# Base de datos
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=              # contraseña segura aleatoria (min 20 caracteres)
POSTGRES_DB=dispatch_track
DATABASE_URL=postgresql://dispatch:POSTGRES_PASSWORD@postgres:5432/dispatch_track?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT — OBLIGATORIO: mínimo 64 caracteres aleatorios
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# QR — generar con: openssl rand -hex 32
QR_HMAC_SECRET=

# URLs
FRONTEND_URL=https://tu-dominio.com
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com

# Puerto
PORT=3001
